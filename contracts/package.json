{
  "name": "@deliveryos/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Type-only contracts shared between the extension host and webviews.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./memory": { "import": "./dist/memory.js", "types": "./dist/memory.d.ts" },
    "./links": { "import": "./dist/links.js", "types": "./dist/links.d.ts" },
    "./panels/*": {
      "import": "./dist/panels/*.js",
      "types": "./dist/panels/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vscode-messenger-common": "^0.4.5"
  }
}
