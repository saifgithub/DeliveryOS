# Dependencies
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Build outputs
# NOTE: /build/ is root-anchored on purpose — docs/build/ is a tracked
# process folder and must NOT be ignored.
dist/
*.tsbuildinfo
/build/
.next/
out/
*.egg-info/
*.vsix

# Env and secrets
.env
.env.local
.env.*.local
*.pem
secrets/

# Local DB
*.sqlite
*.sqlite3
*.db
# Dogfood project state — track the memory store so the arc is reproducible
!.deliveryos/memory.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.code-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/
htmlcov/
.coverage

# Generated artefacts (project-specific PRD outputs, context packages, etc.)
generated/
.deliveryos-cache/
.deliveryos-reverse/

# Claude Code session state (worktrees and the active-track pointer)
.claude/worktrees/
.claude/active-track

# Generated copies for .vsix packaging (root LICENSE + README are canonical)
/extension/LICENSE
/extension/readme.md

# Gate runtime artifact (the dir is tracked via .gitkeep; the result file is per-run)
docs/build/gate/last-run.json
